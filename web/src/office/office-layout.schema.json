{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/office/office-layout.schema.json",
  "title": "Agent Teams office layout",
  "description": "Describes the pixel-art project office: canvas, rooms, furniture, data-bound widgets, thread work-area templates, walking graph, state-to-place rules, sprites and employee looks. See docs/v2/office-layout.md.",
  "type": "object",
  "required": ["format", "id", "name", "canvas", "sprites", "characters", "looks", "rooms", "threadPods", "anchors", "nav", "states"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1, "description": "Layout format version. Bumped only on breaking changes." },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "extends": { "$ref": "#/$defs/id", "description": "Optional base layout id. Top-level objects are deep-merged (maps by key, arrays replaced; rooms/furniture/widgets merged by id)." },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "pixel"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 200, "maximum": 8000 },
        "height": { "type": "integer", "minimum": 200, "maximum": 8000 },
        "pixel": { "type": "integer", "minimum": 1, "maximum": 16, "description": "CSS px per art pixel for character sprites." },
        "background": { "$ref": "#/$defs/color" },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "width": { "type": "integer", "minimum": 0, "maximum": 32 },
            "radius": { "type": "integer", "minimum": 0, "maximum": 64 }
          }
        },
        "page": { "$ref": "#/$defs/color", "description": "Background of the page around the scene." }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "bubble": { "type": "string" },
        "googleFonts": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9 ]+$" }, "maxItems": 4 }
      }
    },
    "palette": {
      "type": "object",
      "description": "Named colors; reference anywhere a color is accepted as $name.",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/literalColor" }
    },
    "floors": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/floor" }
    },
    "sprites": {
      "type": "object",
      "description": "Furniture and widget sprites.",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/sprite" }
    },
    "characters": {
      "type": "object",
      "description": "Pixel-grid character bodies. Exactly one is used for employees (key 'person').",
      "required": ["person"],
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/character" }
    },
    "looks": { "$ref": "#/$defs/looks" },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/room" }
    },
    "furniture": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/furniture" }
    },
    "widgets": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/widget" }
    },
    "threadPods": { "$ref": "#/$defs/threadPods" },
    "anchors": {
      "type": "object",
      "description": "Named groups of positions people can be sent to (place: 'anchor:<name>').",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/anchor" }
    },
    "nav": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "walkSpeed": { "type": "number", "minimum": 10, "maximum": 1000, "description": "CSS px per second." },
        "nodes": { "$ref": "#/$defs/navNodes" },
        "edges": { "$ref": "#/$defs/navEdges" }
      }
    },
    "states": { "$ref": "#/$defs/states" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "room": { "$ref": "#/$defs/textStyle" },
        "nameTag": { "$ref": "#/$defs/textStyle" },
        "timer": { "$ref": "#/$defs/textStyle" }
      }
    },
    "bubbles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": { "enum": ["label", "bubble"] },
        "size": { "type": "integer", "minimum": 8, "maximum": 24 },
        "maxChars": { "type": "integer", "minimum": 4, "maximum": 80 },
        "offset": { "$ref": "#/$defs/point" },
        "shadow": { "type": "string" },
        "ttlMs": { "type": "integer", "minimum": 1000 },
        "kinds": {
          "type": "object",
          "required": ["plain"],
          "propertyNames": { "enum": ["plain", "ask", "error", "done"] },
          "additionalProperties": {
            "type": "object",
            "required": ["bg", "border"],
            "additionalProperties": false,
            "properties": { "bg": { "$ref": "#/$defs/color" }, "border": { "$ref": "#/$defs/color" }, "color": { "$ref": "#/$defs/color" } }
          }
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "clickPlate": { "enum": ["focusThread", "openThread", "none"] }
      }
    },
    "legend": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["label", "color"],
        "additionalProperties": false,
        "properties": { "label": { "type": "string", "maxLength": 24 }, "color": { "$ref": "#/$defs/color" } }
      }
    },
    "meta": { "type": "object", "description": "Free-form notes; ignored by the renderer." }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$" },
    "literalColor": {
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{3}|#[0-9A-Fa-f]{4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|rgba?\\([0-9., ]+\\))$"
    },
    "color": {
      "type": "string",
      "description": "Literal (#hex, rgb(), rgba()), palette reference ($name), runtime slot (@name: look/sprite slot), template ({threadColor}), or shade(<color>,<-1..1>).",
      "pattern": "^(#[0-9A-Fa-f]{3,8}|rgba?\\([0-9., ]+\\)|\\$[A-Za-z][A-Za-z0-9_]*|@[A-Za-z][A-Za-z0-9_]*|\\{[A-Za-z][A-Za-z0-9_]*\\}|shade\\(.+,\\s*-?[0-9.]+\\))$"
    },
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "items": false, "minItems": 2 },
    "rect": {
      "type": "array",
      "description": "[x, y, w, h] in scene CSS px.",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number", "minimum": 1 }, { "type": "number", "minimum": 1 }],
      "items": false,
      "minItems": 4
    },
    "template": { "type": "string", "maxLength": 120, "description": "Text with {placeholders} filled from live data." },
    "floor": {
      "type": "object",
      "required": ["base", "pattern"],
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/$defs/color" },
        "pattern": { "enum": ["plain", "planks", "grid", "checker", "image"] },
        "line": { "$ref": "#/$defs/color" },
        "line2": { "$ref": "#/$defs/color" },
        "stepX": { "type": "number", "minimum": 2 },
        "stepY": { "type": "number", "minimum": 2 },
        "lineWidth": { "type": "number", "minimum": 0.5, "maximum": 8 },
        "src": { "type": "string", "description": "pattern=image: tile image URL under /office/assets/." }
      }
    },
    "shape": {
      "type": "object",
      "required": ["type", "x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["rect", "ellipse"] },
        "x": { "type": "number" }, "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 }, "h": { "type": "number", "minimum": 0 },
        "fill": { "$ref": "#/$defs/color" },
        "stroke": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 16 },
        "radius": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 4, "maxItems": 4 }
          ]
        }
      }
    },
    "sprite": {
      "type": "object",
      "required": ["kind", "w", "h"],
      "properties": {
        "kind": { "enum": ["shapes", "pixels", "image"] },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "slots": {
          "type": "object",
          "description": "Default values for @slot colors used by this sprite (overridden at runtime, e.g. a desk's screen color).",
          "additionalProperties": { "$ref": "#/$defs/color" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "shapes" },
            "shapes": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/shape" } },
            "w": true, "h": true, "slots": true
          },
          "required": ["shapes"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "pixels" },
            "pixel": { "type": "integer", "minimum": 1, "maximum": 16 },
            "rows": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 128 } },
            "colors": { "$ref": "#/$defs/charColors" },
            "w": true, "h": true, "slots": true
          },
          "required": ["rows", "colors"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "image" },
            "src": { "type": "string", "pattern": "^(/office/assets/|https://)[^\\s]+$" },
            "frames": { "type": "integer", "minimum": 1, "maximum": 64 },
            "fps": { "type": "number", "minimum": 0, "maximum": 30 },
            "w": true, "h": true, "slots": true
          },
          "required": ["src"],
          "additionalProperties": false
        }
      ]
    },
    "charColors": {
      "type": "object",
      "description": "Single-character keys used in pixel rows mapped to colors ('.' is always transparent).",
      "propertyNames": { "pattern": "^[^.\\s]$" },
      "additionalProperties": { "$ref": "#/$defs/color" }
    },
    "cell": {
      "type": "array",
      "description": "[x, y, colorKeyOrColor] in art pixels relative to the sprite's top-left; may be outside the grid.",
      "prefixItems": [{ "type": "integer" }, { "type": "integer" }, { "type": "string" }],
      "items": false,
      "minItems": 3
    },
    "rowPatch": {
      "type": "object",
      "description": "Per part: row index -> replacement row.",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[0-9]{1,3}$" },
        "additionalProperties": { "type": "string" }
      }
    },
    "character": {
      "type": "object",
      "required": ["pixel", "width", "colors", "parts", "frames", "animations"],
      "additionalProperties": false,
      "properties": {
        "pixel": { "type": "integer", "minimum": 1, "maximum": 16 },
        "width": { "type": "integer", "minimum": 1, "maximum": 64 },
        "anchor": {
          "type": "object",
          "description": "Foot point in CSS px relative to the sprite top-left; used for z-ordering.",
          "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        },
        "colors": { "$ref": "#/$defs/charColors" },
        "parts": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "maxLength": 64 } }
        },
        "frames": {
          "type": "object",
          "required": ["stand", "walkA", "walkB", "sit"],
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "description": "Parts stacked top to bottom." }
        },
        "animations": {
          "type": "object",
          "required": ["stand", "walk", "sit"],
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "required": ["frames"],
            "additionalProperties": false,
            "properties": {
              "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
              "fps": { "type": "number", "minimum": 0, "maximum": 30 },
              "bob": { "type": "integer", "minimum": 0, "maximum": 8, "description": "Vertical bob amplitude in CSS px." }
            }
          }
        },
        "overlays": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "required": ["cells"],
            "additionalProperties": false,
            "properties": {
              "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cell" } },
              "blinkFps": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          }
        }
      }
    },
    "looks": {
      "type": "object",
      "required": ["outfits", "accessories", "colors", "hair", "defaults"],
      "additionalProperties": false,
      "properties": {
        "outfits": {
          "type": "object",
          "required": ["tee", "hoodie", "suit", "coat"],
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/lookPiece" }
        },
        "accessories": {
          "type": "object",
          "required": ["none", "glasses", "headset", "cap"],
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/lookPiece" }
        },
        "colors": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/literalColor" }, "description": "Swatches offered in the Team screen and used by 'random'." },
        "hair": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/literalColor" } },
        "skin": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/literalColor" } },
        "variation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hair": { "enum": ["byInstance", "fixed", "random"] },
            "shirtShade": { "type": "array", "items": { "type": "number", "minimum": -1, "maximum": 1 }, "maxItems": 8 }
          }
        },
        "defaults": {
          "type": "object",
          "description": "Fallback look per role key (or tier: coordinator, lead); '*' for anything else. A role template's look overrides these.",
          "required": ["*"],
          "additionalProperties": { "$ref": "#/$defs/look" }
        }
      }
    },
    "lookPiece": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 12 },
        "colors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/color" }, "description": "Overrides of character color keys or look slots (shirt, accent, pants)." },
        "patch": { "$ref": "#/$defs/rowPatch" },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "look": {
      "type": "object",
      "required": ["color", "outfit", "accessory"],
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/literalColor" },
        "outfit": { "$ref": "#/$defs/id" },
        "accessory": { "$ref": "#/$defs/id" },
        "hair": { "anyOf": [{ "$ref": "#/$defs/literalColor" }, { "type": "null" }] }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "label", "kind", "rect", "floor"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "maxLength": 40 },
        "kind": { "enum": ["dev", "decision", "coordinator", "lounge", "waiting", "machine", "other"] },
        "rect": { "$ref": "#/$defs/rect" },
        "floor": { "$ref": "#/$defs/id" },
        "doors": {
          "type": "array",
          "maxItems": 16,
          "description": "Openings in the wall. Semantic check: every nav edge (global, pod exits after compilation) and every anchor-point-to-nav link may cross this room's wall only inside a door. Rooms without 'doors' are not checked (a warning is reported).",
          "items": {
            "type": "object",
            "required": ["side", "offset"],
            "additionalProperties": false,
            "properties": {
              "side": { "enum": ["n", "s", "e", "w"] },
              "offset": { "type": "number", "minimum": 0, "description": "Center of the door, measured from the room's left (n/s) or top (e/w) edge." },
              "width": { "type": "number", "minimum": 8, "maximum": 400, "default": 24 },
              "draw": { "type": "boolean", "default": true, "description": "Leave a gap in the drawn wall." }
            }
          }
        },
        "wall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "width": { "type": "number", "minimum": 0, "maximum": 16 },
            "style": { "enum": ["solid", "dashed"] }
          }
        },
        "labelStyle": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "bg": { "$ref": "#/$defs/color" }, "fg": { "$ref": "#/$defs/color" }, "hidden": { "type": "boolean" } }
        },
        "z": { "type": "integer" }
      }
    },
    "furniture": {
      "type": "object",
      "required": ["id", "sprite", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sprite": { "$ref": "#/$defs/id" },
        "at": { "$ref": "#/$defs/point" },
        "room": { "$ref": "#/$defs/id" },
        "z": { "type": "integer" },
        "flip": { "type": "boolean" },
        "label": { "type": "string", "maxLength": 40 },
        "slots": { "type": "object", "additionalProperties": { "$ref": "#/$defs/color" } }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/template" },
        "at": { "$ref": "#/$defs/point" },
        "offset": { "$ref": "#/$defs/point" },
        "font": { "enum": ["label", "bubble"] },
        "size": { "type": "integer", "minimum": 6, "maximum": 32 },
        "color": { "$ref": "#/$defs/color" },
        "bg": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "padding": { "$ref": "#/$defs/point" },
        "maxChars": { "type": "integer", "minimum": 2, "maximum": 80 },
        "dot": { "$ref": "#/$defs/color" }
      }
    },
    "widget": {
      "type": "object",
      "required": ["id", "type", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["taskBoard", "nodeRacks", "pipelinePanel"] },
        "at": { "$ref": "#/$defs/point" },
        "room": { "$ref": "#/$defs/id" },
        "z": { "type": "integer" },
        "click": { "enum": ["openTaskPool", "openNode", "openMergeQueue", "none"] }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "taskBoard" },
            "sprite": { "$ref": "#/$defs/id" },
            "text": { "$ref": "#/$defs/textStyle" },
            "id": true, "at": true, "room": true, "z": true, "click": true
          },
          "required": ["sprite"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "nodeRacks" },
            "sprite": { "$ref": "#/$defs/id" },
            "grid": {
              "type": "object",
              "required": ["columns", "stepX", "stepY"],
              "additionalProperties": false,
              "properties": {
                "columns": { "type": "integer", "minimum": 1, "maximum": 16 },
                "stepX": { "type": "number" },
                "stepY": { "type": "number" },
                "maxItems": { "type": "integer", "minimum": 1, "maximum": 64 }
              }
            },
            "slot": {
              "type": "object",
              "required": ["sprite", "at", "stepY", "max"],
              "additionalProperties": false,
              "properties": {
                "sprite": { "$ref": "#/$defs/id" },
                "at": { "$ref": "#/$defs/point" },
                "stepY": { "type": "number" },
                "max": { "type": "integer", "minimum": 1, "maximum": 32 }
              }
            },
            "slotColors": {
              "type": "object",
              "required": ["active", "empty"],
              "propertyNames": { "enum": ["active", "parked", "queued", "empty", "offline"] },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "led": { "$ref": "#/$defs/color" },
                  "led2": { "$ref": "#/$defs/color" },
                  "blink": { "enum": ["led", "led2"] }
                }
              }
            },
            "label": { "$ref": "#/$defs/textStyle" },
            "overflowLabel": { "$ref": "#/$defs/template" },
            "id": true, "at": true, "room": true, "z": true, "click": true
          },
          "required": ["sprite", "grid", "slot", "slotColors"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "pipelinePanel" },
            "w": { "type": "number", "minimum": 40 },
            "style": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bg": { "$ref": "#/$defs/color" }, "border": { "$ref": "#/$defs/color" }, "color": { "$ref": "#/$defs/color" },
                "title": { "$ref": "#/$defs/color" }, "size": { "type": "integer" }, "padding": { "type": "number" }, "gap": { "type": "number" }
              }
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["kind", "title"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["mergeQueue", "ci"] },
                  "title": { "type": "string", "maxLength": 20 },
                  "maxItems": { "type": "integer", "minimum": 1, "maximum": 12 },
                  "row": { "$ref": "#/$defs/template" },
                  "stateLabels": { "type": "object", "additionalProperties": { "type": "string" } },
                  "stateColors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/color" } },
                  "colors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/color" } },
                  "blink": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "id": true, "at": true, "room": true, "z": true, "click": true
          },
          "required": ["w", "sections"],
          "additionalProperties": false
        }
      ]
    },
    "navNodes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/point" }
    },
    "navEdges": {
      "type": "array",
      "description": "Undirected edges between node ids.",
      "items": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/id" }, { "$ref": "#/$defs/id" }], "items": false, "minItems": 2 }
    },
    "podTemplate": {
      "type": "object",
      "required": ["size", "desks", "nav"],
      "additionalProperties": false,
      "properties": {
        "size": { "$ref": "#/$defs/point" },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/color" }, "focusColor": { "$ref": "#/$defs/color" },
            "width": { "type": "number", "minimum": 0, "maximum": 8 }, "style": { "enum": ["solid", "dashed"] }
          }
        },
        "plate": { "$ref": "#/$defs/textStyle" },
        "desks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "sprite", "at", "seat"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "sprite": { "$ref": "#/$defs/id" },
              "at": { "$ref": "#/$defs/point", "description": "Pod-local position of the desk sprite." },
              "seat": { "$ref": "#/$defs/point", "description": "Pod-local top-left of the person sitting here." },
              "for": { "enum": ["lead", "member", "any"] },
              "timer": { "$ref": "#/$defs/point", "description": "Desk-local position of the time-in-task label." }
            }
          }
        },
        "overflowSeats": { "type": "array", "items": { "$ref": "#/$defs/point" }, "maxItems": 16 },
        "nav": {
          "type": "object",
          "required": ["nodes", "edges", "seatLinks", "exits"],
          "additionalProperties": false,
          "properties": {
            "nodes": { "$ref": "#/$defs/navNodes" },
            "edges": { "$ref": "#/$defs/navEdges" },
            "seatLinks": { "type": "object", "description": "Seat row -> pod nav node the seat connects to.", "additionalProperties": { "$ref": "#/$defs/id" } },
            "exits": { "type": "object", "description": "Pod nav node -> global nav node.", "additionalProperties": { "$ref": "#/$defs/id" } }
          }
        }
      }
    },
    "threadPods": {
      "type": "object",
      "required": ["area", "templates", "layout", "seating"],
      "additionalProperties": false,
      "properties": {
        "area": {
          "type": "object",
          "required": ["rect"],
          "additionalProperties": false,
          "properties": { "room": { "$ref": "#/$defs/id" }, "rect": { "$ref": "#/$defs/rect" } }
        },
        "templates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/podTemplate" }
        },
        "layout": {
          "type": "object",
          "required": ["mode", "use"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["grid"] },
            "gap": { "$ref": "#/$defs/point" },
            "columns": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 16 }, { "const": "auto" }] },
            "use": {
              "type": "array",
              "minItems": 1,
              "description": "First entry whose maxThreads >= visible thread count picks the template.",
              "items": {
                "type": "object",
                "required": ["maxThreads", "template"],
                "additionalProperties": false,
                "properties": { "maxThreads": { "type": "integer", "minimum": 1 }, "template": { "$ref": "#/$defs/id" } }
              }
            },
            "overflow": { "enum": ["paginate", "scale"] },
            "offPage": {
              "enum": ["hide", "anchorsWithBadge"],
              "default": "anchorsWithBadge",
              "description": "With overflow 'paginate': where employees of threads on other pages are drawn. 'hide' = not drawn anywhere (their counts show in the pager). 'anchorsWithBadge' = not drawn at seats, but still drawn at shared anchors (lounge, bench, decision room, machine room, task board) with a small '#<no>' badge in the thread color; raising hands also add a dot on the pager."
            },
            "order": { "enum": ["no", "updated", "status"] },
            "pinFocused": { "type": "boolean" },
            "show": {
              "type": "array",
              "items": { "enum": ["queued", "running", "waiting", "review", "paused", "done", "failed", "archived"] },
              "uniqueItems": true
            }
          }
        },
        "seating": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "leadDesk": { "$ref": "#/$defs/id" },
            "order": { "type": "array", "items": { "enum": ["roleSort", "instance", "name"] } },
            "rowOf": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "threadColors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/literalColor" } }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["points"],
      "additionalProperties": false,
      "properties": {
        "points": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/point" } },
        "pose": { "enum": ["stand", "sit"] },
        "facing": { "enum": ["up", "down", "left", "right"] },
        "nav": { "$ref": "#/$defs/id", "description": "Global nav node this anchor connects to." },
        "overflow": { "enum": ["jitter", "standBehind", "stack"] }
      }
    },
    "place": {
      "type": "string",
      "pattern": "^(seat|current|anchor:[A-Za-z][A-Za-z0-9_-]*)$"
    },
    "stateName": {
      "enum": ["typing", "reading", "running", "thinking", "walking_to_board", "claiming", "returning", "raising_hand", "idle", "waiting", "queued", "offline", "broken"]
    },
    "stateRule": {
      "type": "object",
      "required": ["match", "place"],
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": { "type": "array", "items": { "$ref": "#/$defs/stateName" }, "minItems": 1 },
            "substate": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "tier": { "enum": ["coordinator", "lead", "member"] },
            "role": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "taskKind": { "type": "array", "items": { "enum": ["work", "fix", "review", "decision", "test"] }, "minItems": 1 }
          }
        },
        "place": { "$ref": "#/$defs/place" },
        "anim": { "type": "string", "description": "Animation id of the character, or 'keep' to keep the current one." },
        "overlay": { "$ref": "#/$defs/id" },
        "screen": { "$ref": "#/$defs/color", "description": "Sets the occupied desk's @screen slot." },
        "timer": { "type": "boolean" },
        "bubble": { "type": "string", "maxLength": 40, "description": "Default bubble text when the platform/set_status gives none." },
        "bubbleKind": { "enum": ["plain", "ask", "error", "done"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "grayscale": { "type": "boolean" }
      }
    },
    "states": {
      "type": "object",
      "required": ["rules"],
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateRule" }, "description": "First matching rule wins; end with a catch-all {match:{}}." },
        "sequences": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "required": ["trigger", "steps"],
            "additionalProperties": false,
            "properties": {
              "trigger": {
                "type": "object",
                "required": ["state"],
                "additionalProperties": false,
                "properties": { "state": { "$ref": "#/$defs/stateName" }, "cause": { "type": "string" } }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "goto": { "$ref": "#/$defs/place" },
                    "wait": { "type": "integer", "minimum": 0, "maximum": 60000 },
                    "anim": { "type": "string" },
                    "bubble": { "$ref": "#/$defs/template" }
                  }
                }
              }
            }
          }
        },
        "walkAnim": { "type": "string" },
        "maxConcurrentWalks": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    }
  }
}
