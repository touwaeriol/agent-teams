{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/common.json",
  "title": "Common",
  "description": "Shared definitions for node protocol messages.",
  "$defs": {
    "SessionId": {
      "title": "SessionId",
      "description": "Console-generated session id: s_ + ULID (at_agent_sessions.id).",
      "type": "string",
      "pattern": "^s_"
    },
    "OpenGen": {
      "title": "OpenGen",
      "description": "How many times the session has been opened; +1 on every resume.",
      "type": "integer",
      "minimum": 1
    },
    "MsgId": {
      "title": "MsgId",
      "description": "Console message id: m_ + ULID (at_messages).",
      "type": "string",
      "pattern": "^m_"
    },
    "ImageRef": {
      "title": "ImageRef",
      "description": "An image the user attached to a message (at_attachments). The daemon downloads it with GET <console>/nodes/attachments/<id> and its node token, then hands it to the runtime: Claude gets an image content block (a document block for a PDF), Codex a localImage input item (a PDF is saved and its path named in the text).",
      "type": "object",
      "required": [
        "id",
        "media_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^img_"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "application/pdf"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        }
      }
    },
    "JobId": {
      "title": "JobId",
      "description": "Git job id: g_ + ULID.",
      "type": "string",
      "pattern": "^g_"
    },
    "ApprovalId": {
      "title": "ApprovalId",
      "description": "ap_ + sha256(session_id + ':' + tool_use_id)[:24].",
      "type": "string",
      "pattern": "^ap_"
    },
    "CallId": {
      "title": "CallId",
      "description": "Platform tool call id: tc_ + ULID, generated by the daemon.",
      "type": "string",
      "pattern": "^tc_"
    },
    "UploadId": {
      "title": "UploadId",
      "description": "File upload id (up_ + ULID), generated by the daemon.",
      "type": "string",
      "pattern": "^up_[0-9A-Za-z]{10,40}$"
    },
    "DownloadId": {
      "title": "DownloadId",
      "description": "File download id (dn_ + id), generated by the console for read_deliverable.",
      "type": "string",
      "pattern": "^dn_[0-9A-Za-z_]{10,60}$"
    },
    "TurnId": {
      "title": "TurnId",
      "description": "Turn id inside a session.",
      "type": "string",
      "pattern": "^t_"
    },
    "Timestamp": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp (UTC).",
      "type": "string",
      "format": "date-time"
    },
    "RelPath": {
      "title": "RelPath",
      "description": "Path relative to the daemon root; never absolute.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]"
    },
    "Repo": {
      "title": "Repo",
      "description": "GitHub repository as owner/name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "Runtime": {
      "title": "Runtime",
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "Tier": {
      "title": "Tier",
      "type": "string",
      "enum": [
        "coordinator",
        "lead",
        "member"
      ]
    },
    "PermissionMode": {
      "title": "PermissionMode",
      "description": "Claude permission mode; always explicit. The console opens writing members in bypassPermissions (with allow_dangerously_skip_permissions) or default (ask roles), and the coordinator, lead and read-only roles in dontAsk. auto is kept for old consoles only.",
      "type": "string",
      "enum": [
        "default",
        "acceptEdits",
        "bypassPermissions",
        "dontAsk",
        "plan",
        "auto"
      ]
    },
    "LogLevel": {
      "title": "LogLevel",
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "ContentBlock": {
      "title": "ContentBlock",
      "description": "MCP tool result content block.",
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "ApprovalDecision": {
      "title": "ApprovalDecision",
      "type": "string",
      "enum": [
        "allow",
        "allow_always",
        "deny"
      ]
    },
    "TodoItem": {
      "title": "TodoItem",
      "type": "object",
      "required": [
        "content",
        "status"
      ],
      "properties": {
        "content": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed"
          ]
        },
        "active_form": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "ContextUsage": {
      "title": "ContextUsage",
      "description": "How much of the context window a session uses (shared-members.md §5.3).",
      "type": "object",
      "required": [
        "used_tokens",
        "max_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "used_tokens": {
          "description": "Tokens in the context now (Claude: getContextUsage totalTokens; Codex: the last request's total tokens).",
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "description": "The window the runtime measures against (Claude: the autocompact window; Codex: the model's context window); 0 when unknown.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
