{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/common.json",
  "title": "Common",
  "description": "Shared definitions for node protocol messages.",
  "$defs": {
    "SessionId": {
      "title": "SessionId",
      "description": "Console-generated session id: s_ + ULID (at_agent_sessions.id).",
      "type": "string",
      "pattern": "^s_"
    },
    "OpenGen": {
      "title": "OpenGen",
      "description": "How many times the session has been opened; +1 on every resume.",
      "type": "integer",
      "minimum": 1
    },
    "MsgId": {
      "title": "MsgId",
      "description": "Console message id: m_ + ULID (at_messages).",
      "type": "string",
      "pattern": "^m_"
    },
    "JobId": {
      "title": "JobId",
      "description": "Git job id: g_ + ULID.",
      "type": "string",
      "pattern": "^g_"
    },
    "ApprovalId": {
      "title": "ApprovalId",
      "description": "ap_ + sha256(session_id + ':' + tool_use_id)[:24].",
      "type": "string",
      "pattern": "^ap_"
    },
    "CallId": {
      "title": "CallId",
      "description": "Platform tool call id: tc_ + ULID, generated by the daemon.",
      "type": "string",
      "pattern": "^tc_"
    },
    "UploadId": {
      "title": "UploadId",
      "description": "File upload id (up_ + ULID), generated by the daemon.",
      "type": "string",
      "pattern": "^up_[0-9A-Za-z]{10,40}$"
    },
    "TurnId": {
      "title": "TurnId",
      "description": "Turn id inside a session.",
      "type": "string",
      "pattern": "^t_"
    },
    "Timestamp": {
      "title": "Timestamp",
      "description": "RFC 3339 timestamp (UTC).",
      "type": "string",
      "format": "date-time"
    },
    "RelPath": {
      "title": "RelPath",
      "description": "Path relative to the daemon root; never absolute.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]"
    },
    "Repo": {
      "title": "Repo",
      "description": "GitHub repository as owner/name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "Runtime": {
      "title": "Runtime",
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "Tier": {
      "title": "Tier",
      "type": "string",
      "enum": [
        "coordinator",
        "lead",
        "member"
      ]
    },
    "PermissionMode": {
      "title": "PermissionMode",
      "description": "Claude permission mode; always explicit.",
      "type": "string",
      "enum": [
        "default",
        "acceptEdits",
        "bypassPermissions",
        "dontAsk",
        "plan"
      ]
    },
    "LogLevel": {
      "title": "LogLevel",
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "ContentBlock": {
      "title": "ContentBlock",
      "description": "MCP tool result content block.",
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "ApprovalDecision": {
      "title": "ApprovalDecision",
      "type": "string",
      "enum": [
        "allow",
        "allow_always",
        "deny"
      ]
    }
  }
}
