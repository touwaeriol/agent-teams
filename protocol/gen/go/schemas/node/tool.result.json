{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/tool.result.json",
  "title": "ToolResult",
  "description": "Result of a tool.call; ok=false becomes an MCP isError result.",
  "x-direction": "console_to_node",
  "x-key": [
    "call_id"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "session_id",
    "call_id",
    "ok",
    "content"
  ],
  "properties": {
    "session_id": {
      "$ref": "common.json#/$defs/SessionId"
    },
    "call_id": {
      "$ref": "common.json#/$defs/CallId"
    },
    "ok": {
      "type": "boolean"
    },
    "content": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/ContentBlock"
      }
    },
    "structured": {
      "description": "Optional structured result matching the tool result schema; null when the tool only returns text.",
      "type": [
        "object",
        "null"
      ]
    },
    "download": {
      "description": "read_deliverable: files whose bytes arrived before as file.download frames; the daemon writes them under .agent-deliverables/<deliverable_id>/v<version>/ in the session's working directory.",
      "$ref": "#/$defs/ToolDownload"
    }
  },
  "$defs": {
    "ToolDownload": {
      "title": "ToolDownload",
      "type": "object",
      "required": [
        "download_id",
        "deliverable_id",
        "version",
        "chunks",
        "files"
      ],
      "properties": {
        "download_id": {
          "$ref": "common.json#/$defs/DownloadId"
        },
        "deliverable_id": {
          "type": "string",
          "pattern": "^dl_[A-Za-z0-9]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "chunks": {
          "description": "Number of file.download frames (0 when every file is empty).",
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/DownloadFile"
          }
        }
      }
    },
    "DownloadFile": {
      "title": "DownloadFile",
      "type": "object",
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "description": "Path inside the deliverable version (index.html, assets/logo.svg …).",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
