{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/git.result.json",
  "title": "GitResult",
  "description": "Result of any git.* job.",
  "x-direction": "node_to_console",
  "x-key": [
    "job_id"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "job_id",
    "ok"
  ],
  "properties": {
    "job_id": {
      "$ref": "common.json#/$defs/JobId"
    },
    "ok": {
      "type": "boolean"
    },
    "head_sha": {
      "type": "string"
    },
    "created": {
      "description": "git.prepare: the worktree/clone was created by this job.",
      "type": "boolean"
    },
    "unchanged": {
      "description": "git.push: nothing to push (no commits outside unchanged_against); head_sha is the checkout's HEAD.",
      "type": "boolean"
    },
    "log_tail": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "error_code": {
      "type": "string",
      "enum": [
        "clone_failed",
        "fetch_failed",
        "not_a_repo",
        "dirty_conflict",
        "path_outside_root",
        "locked_timeout",
        "rejected_non_ff",
        "workflow_permission",
        "auth_failed",
        "refspec_not_allowed",
        "sha_mismatch"
      ]
    },
    "error": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GitCheckoutStatus"
    },
    "removed": {
      "description": "git.cleanup.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kept": {
      "description": "git.cleanup.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/GitKeptPath"
      }
    },
    "sync": {
      "description": "git.prepare with sync: what the sync did.",
      "type": "object",
      "required": [
        "action",
        "head_sha"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "reset",
            "merged",
            "conflict",
            "dirty",
            "checkout",
            "current",
            "absent",
            "expired"
          ],
          "description": "reset: member branch fast-forwarded to origin/<ref>; merged: origin/<ref> merged into unmerged member commits; conflict: that merge conflicted and was aborted; dirty: uncommitted changes, nothing done; checkout: review checkout; current: already up to date; absent: origin/<ref> does not exist (yet); expired: started after the deadline, nothing done."
        },
        "head_sha": {
          "type": "string"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "conflict: the conflicting paths."
        }
      }
    }
  },
  "$defs": {
    "GitCheckoutStatus": {
      "title": "GitCheckoutStatus",
      "type": "object",
      "required": [
        "branch",
        "head_sha",
        "ahead",
        "behind",
        "dirty_files",
        "unpushed_commits"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "dirty_files": {
          "type": "integer",
          "minimum": 0
        },
        "unpushed_commits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "GitKeptPath": {
      "title": "GitKeptPath",
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
