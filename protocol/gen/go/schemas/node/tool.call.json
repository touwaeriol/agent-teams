{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/tool.call.json",
  "title": "ToolCall",
  "description": "An employee called a platform tool.",
  "x-direction": "node_to_console",
  "x-key": [
    "session_id",
    "call_id"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "call_id",
    "session_id",
    "tool",
    "args"
  ],
  "properties": {
    "call_id": {
      "$ref": "common.json#/$defs/CallId"
    },
    "session_id": {
      "$ref": "common.json#/$defs/SessionId"
    },
    "open_gen": {
      "$ref": "common.json#/$defs/OpenGen"
    },
    "tool": {
      "description": "Platform tool name without the mcp__platform__ prefix.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "args": {
      "description": "Tool input; validated by the console against /protocol/schemas/tools/<tool>.json.",
      "type": "object"
    },
    "tool_use_id": {
      "description": "Claude tool_use_id or Codex item id, for diagnostics only.",
      "type": "string"
    },
    "upload": {
      "description": "Files the daemon read for publish_file or write_shared_file; their bytes arrived before as file.chunk frames.",
      "$ref": "#/$defs/ToolUpload"
    }
  },
  "$defs": {
    "ToolUpload": {
      "title": "ToolUpload",
      "type": "object",
      "required": [
        "upload_id",
        "chunks",
        "files"
      ],
      "properties": {
        "upload_id": {
          "$ref": "common.json#/$defs/UploadId"
        },
        "chunks": {
          "description": "Number of file.chunk frames (0 when every file is empty).",
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/UploadFile"
          }
        }
      }
    },
    "UploadFile": {
      "title": "UploadFile",
      "type": "object",
      "required": [
        "path",
        "size",
        "sha256",
        "content_type"
      ],
      "properties": {
        "path": {
          "description": "publish_file: path inside the published deliverable (index.html for a site's entry, or the file name). write_shared_file: exactly one file, and path is the target shared-files path (args.path, or the default the daemon derived from args.file).",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
