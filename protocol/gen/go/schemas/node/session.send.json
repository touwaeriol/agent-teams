{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/session.send.json",
  "title": "SessionSend",
  "description": "Deliver a message to the employee.",
  "x-direction": "console_to_node",
  "x-key": [
    "msg_id"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "session_id",
    "msg_id",
    "text"
  ],
  "properties": {
    "session_id": {
      "$ref": "common.json#/$defs/SessionId"
    },
    "msg_id": {
      "$ref": "common.json#/$defs/MsgId"
    },
    "text": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "now",
        "next",
        "later"
      ],
      "default": "next"
    },
    "kind": {
      "type": "string",
      "enum": [
        "user",
        "task",
        "mail",
        "answer",
        "system"
      ]
    },
    "interrupt_first": {
      "type": "boolean",
      "default": false
    },
    "images": {
      "description": "Images to deliver with the text (at most 8).",
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "common.json#/$defs/ImageRef"
      }
    },
    "anchor": {
      "description": "The task anchor (task id, instruction, branch, hand-off notes, progress). The daemon keeps the latest one and re-injects it after the runtime compacts the session during a task; an empty string clears it.",
      "type": "string",
      "maxLength": 8000
    }
  }
}
