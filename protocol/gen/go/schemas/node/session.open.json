{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/session.open.json",
  "title": "SessionOpen",
  "description": "Open (or resume) a long-lived employee session on the node.",
  "x-direction": "console_to_node",
  "x-key": [
    "session_id",
    "open_gen"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "session_id",
    "open_gen",
    "employee",
    "runtime",
    "cwd",
    "platform_tools"
  ],
  "properties": {
    "session_id": {
      "$ref": "common.json#/$defs/SessionId"
    },
    "open_gen": {
      "$ref": "common.json#/$defs/OpenGen"
    },
    "employee": {
      "$ref": "#/$defs/EmployeeRef"
    },
    "runtime": {
      "$ref": "common.json#/$defs/Runtime"
    },
    "cwd": {
      "$ref": "common.json#/$defs/RelPath"
    },
    "prepare": {
      "description": "Key of the git.prepare job that must have succeeded first.",
      "anyOf": [
        {
          "$ref": "common.json#/$defs/JobId"
        },
        {
          "type": "null"
        }
      ]
    },
    "prepare_jobs": {
      "description": "Every git.prepare job (one per repository) that must have succeeded first; prepare is the first of them.",
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/JobId"
      }
    },
    "resume": {
      "description": "null on first open.",
      "anyOf": [
        {
          "$ref": "#/$defs/ResumeRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "claude": {
      "description": "Set when runtime = claude.",
      "anyOf": [
        {
          "$ref": "#/$defs/ClaudeSessionOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "codex": {
      "description": "Set when runtime = codex.",
      "anyOf": [
        {
          "$ref": "#/$defs/CodexSessionOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "platform_tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlatformToolSpec"
      }
    },
    "env": {
      "description": "Extra non-secret environment; the daemon adds PATH/HOME/MCP_TOOL_TIMEOUT/git credential variables itself.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "git_credentials": {
      "description": "Install the credential helper and gh wrapper.",
      "type": "boolean"
    },
    "first_message": {
      "description": "Held back until session.release.",
      "anyOf": [
        {
          "$ref": "#/$defs/FirstMessage"
        },
        {
          "type": "null"
        }
      ]
    },
    "skills": {
      "description": "Skills of the employee's role. Claude: the daemon writes them as a local plugin outside the worktree and loads it (options.plugins + options.skills). Codex gets them in developer_instructions instead.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/SkillBundle"
      }
    },
    "plugins": {
      "description": "Plugins ticked on the employee's role, each at an exact version (architecture.md §6.5). The daemon writes each into a per-employee directory outside the worktree. Claude: loaded with options.plugins (skipMcpDiscovery), skills lists the plugin's skills and commands, and mcp_servers join options.mcpServers as plugin_<plugin>_<server>. Codex: only mcp_servers are used (the skill text is already in developer_instructions).",
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/PluginBundle"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "claude"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "claude"
        ],
        "properties": {
          "claude": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "codex"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "codex"
        ],
        "properties": {
          "codex": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "EmployeeRef": {
      "title": "EmployeeRef",
      "type": "object",
      "required": [
        "name",
        "tier",
        "project_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "tier": {
          "$ref": "common.json#/$defs/Tier"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "thread_no": {
          "description": "The thread the session works in; null for the coordinator and a project member outside any thread.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scope": {
          "description": "Where the employee belongs: \"project\" for the coordinator and the project members shared by every thread (skills and plugins live in <project>/project/<name>), \"thread\" for a lead or a member created with a thread. Absent from older consoles: a null thread_no means project.",
          "type": "string",
          "enum": [
            "project",
            "thread"
          ]
        }
      }
    },
    "ResumeRef": {
      "title": "ResumeRef",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "sdk_session_id": {
          "type": "string",
          "minLength": 1
        },
        "codex_thread_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ClaudeSessionOptions": {
      "title": "ClaudeSessionOptions",
      "type": "object",
      "required": [
        "model",
        "tools",
        "allowed_tools",
        "permission_mode",
        "setting_sources"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "system_append": {
          "type": "string"
        },
        "tools": {
          "description": "SDK options.tools; [] means no built-in tools.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disallowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permission_mode": {
          "$ref": "common.json#/$defs/PermissionMode"
        },
        "allow_dangerously_skip_permissions": {
          "description": "Required for bypassPermissions and session.set_mode to bypassPermissions.",
          "type": "boolean"
        },
        "setting_sources": {
          "description": "Always [] (architecture.md 6.1).",
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "max_turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "read_only": {
          "description": "Lead and read_only roles: enables bash_policy and a sandbox without writable paths.",
          "type": "boolean"
        },
        "bash_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/BashPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxPolicy"
        },
        "deny_non_platform_tools": {
          "description": "Coordinator: PreToolUse hook rejects everything except mcp__platform__*.",
          "type": "boolean"
        },
        "protected_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BashPolicy": {
      "title": "BashPolicy",
      "description": "argv-parsed allow list for read-only sessions (not regex).",
      "type": "object",
      "required": [
        "mode",
        "allow"
      ],
      "properties": {
        "mode": {
          "const": "argv"
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_metachar": {
          "type": "boolean"
        }
      }
    },
    "SandboxPolicy": {
      "title": "SandboxPolicy",
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CodexSessionOptions": {
      "title": "CodexSessionOptions",
      "type": "object",
      "required": [
        "model",
        "sandbox",
        "approval_policy"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ]
        },
        "approval_policy": {
          "type": "string",
          "enum": [
            "never",
            "on-request",
            "on-failure",
            "untrusted"
          ]
        },
        "developer_instructions": {
          "type": "string"
        },
        "config": {
          "description": "Extra thread/start config (e.g. sandbox_workspace_write.writable_roots); mcp_servers.platform is filled in by the daemon.",
          "type": "object"
        }
      }
    },
    "PlatformToolSpec": {
      "title": "PlatformToolSpec",
      "description": "One platform tool, from /protocol/schemas/tools.",
      "type": "object",
      "required": [
        "name",
        "description",
        "input_schema",
        "blocking"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "FirstMessage": {
      "title": "FirstMessage",
      "type": "object",
      "required": [
        "msg_id",
        "text"
      ],
      "properties": {
        "msg_id": {
          "$ref": "common.json#/$defs/MsgId"
        },
        "text": {
          "type": "string"
        },
        "images": {
          "description": "Images to deliver with the text (at most 8).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "common.json#/$defs/ImageRef"
          }
        }
      }
    },
    "SkillBundle": {
      "title": "SkillBundle",
      "type": "object",
      "required": [
        "name",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "files": {
          "description": "Text files of the skill; SKILL.md is required.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/SkillFile"
          }
        }
      }
    },
    "SkillFile": {
      "title": "SkillFile",
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "description": "Relative path inside the skill directory.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "PluginBundle": {
      "title": "PluginBundle",
      "type": "object",
      "required": [
        "name",
        "version",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "version": {
          "description": "Library version number (1, 2, …); the directory is <name>@<version>.",
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "description": "Every file of the package, .claude-plugin/plugin.json included.",
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/PluginFile"
          }
        },
        "skills": {
          "description": "Qualified names (<plugin>:<skill or command>) to add to options.skills.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "description": "Qualified subagent names (<plugin>:<agent>), informational.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp_servers": {
          "description": "The plugin's MCP servers by name; ${CLAUDE_PLUGIN_ROOT} is replaced by the plugin directory.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PluginMcpServer"
          }
        }
      }
    },
    "PluginFile": {
      "title": "PluginFile",
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "description": "Relative path inside the plugin directory; '.' and '..' segments are refused.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[A-Za-z0-9_.@+-]+(/[A-Za-z0-9_.@+-]+)*$"
        },
        "content": {
          "type": "string"
        },
        "encoding": {
          "description": "utf8 (default) or base64 for binary files.",
          "type": "string",
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "PluginMcpServer": {
      "title": "PluginMcpServer",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stdio",
            "http",
            "sse"
          ]
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
