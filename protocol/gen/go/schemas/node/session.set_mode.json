{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/session.set_mode.json",
  "title": "SessionSetMode",
  "description": "Change permission mode and/or model of a session.",
  "x-direction": "console_to_node",
  "x-key": [
    "id"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "session_id"
  ],
  "properties": {
    "session_id": {
      "$ref": "common.json#/$defs/SessionId"
    },
    "permission_mode": {
      "type": "string",
      "enum": [
        "default",
        "acceptEdits",
        "bypassPermissions",
        "auto"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
