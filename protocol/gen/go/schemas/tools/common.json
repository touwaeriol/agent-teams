{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/tools/common.json",
  "title": "ToolCommon",
  "description": "Shared definitions for platform tool inputs and results.",
  "$defs": {
    "TaskId": {
      "title": "TaskId",
      "type": "string",
      "pattern": "^t[0-9]+$"
    },
    "QuestionId": {
      "title": "QuestionId",
      "type": "string",
      "pattern": "^q[0-9]+$"
    },
    "ThreadNo": {
      "title": "ThreadNo",
      "description": "Thread number inside the project (#12).",
      "type": "integer",
      "minimum": 1
    },
    "ThreadStatus": {
      "title": "ThreadStatus",
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "review",
        "done",
        "failed",
        "paused",
        "archived"
      ]
    },
    "TaskStatus": {
      "title": "TaskStatus",
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "running",
        "review",
        "decision",
        "merging",
        "done",
        "failed",
        "cancelled",
        "blocked"
      ]
    },
    "TaskKind": {
      "title": "TaskKind",
      "type": "string",
      "enum": [
        "work",
        "fix",
        "review",
        "decision",
        "test"
      ]
    },
    "PlanStepStatus": {
      "title": "PlanStepStatus",
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "done"
      ]
    },
    "PlanStep": {
      "title": "PlanStep",
      "type": "object",
      "required": [
        "title",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/PlanStepStatus"
        }
      }
    },
    "BubbleKind": {
      "title": "BubbleKind",
      "type": "string",
      "enum": [
        "plain",
        "ask",
        "error",
        "done"
      ]
    },
    "TaskSummary": {
      "title": "TaskSummary",
      "type": "object",
      "required": [
        "task_id",
        "status",
        "instruction"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "assignee": {
          "type": "string"
        },
        "claimed_by": {
          "type": "string"
        },
        "main": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TaskKind"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "instruction": {
          "type": "string"
        }
      }
    },
    "TaskOutcome": {
      "title": "TaskOutcome",
      "description": "Final state of a task that was waited on.",
      "type": "object",
      "required": [
        "task_id",
        "status",
        "result"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "result": {
          "type": "string"
        }
      }
    },
    "QuestionAnswer": {
      "title": "QuestionAnswer",
      "type": "object",
      "required": [
        "question_id"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "answer": {
          "description": "Present when the call blocked until answered.",
          "type": "string"
        },
        "answers": {
          "description": "Structured questions: the user's choice per question, in order (present when the call blocked until answered).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionAnswerItem"
          }
        }
      }
    },
    "Mail": {
      "title": "Mail",
      "type": "object",
      "required": [
        "id",
        "sender",
        "recipient",
        "body",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "sender": {
          "type": "string"
        },
        "recipient": {
          "description": "Employee name, lead or * (broadcast).",
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AskQuestion": {
      "title": "AskQuestion",
      "type": "object",
      "required": [
        "question",
        "header",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "The complete question, ending with a question mark.",
          "type": "string",
          "minLength": 1
        },
        "header": {
          "description": "Very short label shown as a chip (max 12 characters).",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "options": {
          "description": "2-4 distinct choices; an \"other\" free-text answer is always offered, do not add one.",
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/AskOption"
          }
        },
        "multi_select": {
          "description": "Let the user pick several options.",
          "type": "boolean"
        }
      }
    },
    "AskOption": {
      "title": "AskOption",
      "type": "object",
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "The choice, 1-5 words.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "What choosing it means (trade-offs, consequences).",
          "type": "string"
        },
        "recommended": {
          "description": "Mark the option you recommend (at most one per question).",
          "type": "boolean"
        },
        "preview": {
          "description": "Ignored (accepted for AskUserQuestion compatibility).",
          "type": "string"
        }
      }
    },
    "QuestionAnswerItem": {
      "title": "QuestionAnswerItem",
      "type": "object",
      "required": [
        "question",
        "selected"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "selected": {
          "description": "Labels of the chosen options.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "other": {
          "description": "The user's own answer typed into 其他.",
          "type": "string"
        }
      }
    },
    "AttachmentId": {
      "title": "AttachmentId",
      "description": "Attachment id (img_…), as listed in a message's [附件]/[Attachments] block.",
      "type": "string",
      "pattern": "^img_[0-9A-Za-z]{1,60}$"
    },
    "AttachmentIds": {
      "title": "AttachmentIds",
      "description": "Attachments to hand over with this message or task (ids from a message's attachment block, at most 20; duplicates are dropped). They must belong to this project. The recipient's daemon downloads them into its .attachments/ folder.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/AttachmentId"
      }
    },
    "MemoryScope": {
      "title": "MemoryScope",
      "description": "project (default): this project's memory; user: the user's own memory, read by every project of the user.",
      "type": "string",
      "enum": [
        "project",
        "user"
      ],
      "default": "project"
    }
  }
}
