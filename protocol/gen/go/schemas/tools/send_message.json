{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/tools/send_message.json",
  "title": "SendMessageInput",
  "description": "Leave a message for a teammate (instance name) or for the lead (\"lead\"). Busy recipients get it after their current turn.",
  "x-tool": {
    "tiers": [
      "lead",
      "member"
    ],
    "blocking": []
  },
  "type": "object",
  "required": [
    "to",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "to": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "attachments": {
      "$ref": "common.json#/$defs/AttachmentIds"
    }
  }
}
