{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/cred.response.json",
  "title": "CredResponse",
  "description": "Token (or, for an SSH repository, a private key) for a cred.request, or a refusal. Unreliable; never logged.",
  "x-direction": "console_to_node",
  "x-key": [
    "req_id"
  ],
  "x-reliable": false,
  "type": "object",
  "required": [
    "req_id",
    "ok"
  ],
  "properties": {
    "req_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "username": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "ssh_key": {
      "description": "SSH repositories (git-repos.md §5): the private key as unencrypted PKCS#8 PEM, its authorized_keys line and the pinned known_hosts line. Kept in memory by the git-ssh wrapper only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_key",
        "public_key",
        "known_hosts"
      ],
      "properties": {
        "private_key": {
          "type": "string"
        },
        "public_key": {
          "type": "string"
        },
        "known_hosts": {
          "type": "string"
        }
      }
    },
    "expires_at": {
      "$ref": "common.json#/$defs/Timestamp"
    },
    "error": {
      "description": "e.g. repo_not_in_project.",
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "username"
    ],
    "anyOf": [
      {
        "required": [
          "password"
        ]
      },
      {
        "required": [
          "ssh_key"
        ]
      }
    ]
  },
  "else": {
    "required": [
      "error"
    ]
  }
}
