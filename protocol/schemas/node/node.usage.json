{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/node.usage.json",
  "title": "NodeUsage",
  "description": "Subscription quota of the node's Claude Code / Codex logins (protocol.md 9.1). Unreliable; sent after hello and then every few minutes. Never carries credentials, e-mail addresses or organisation ids.",
  "x-direction": "node_to_console",
  "x-reliable": false,
  "type": "object",
  "required": [
    "runtimes"
  ],
  "properties": {
    "runtimes": {
      "type": "object",
      "properties": {
        "claude": {
          "$ref": "#/$defs/RuntimeUsage"
        },
        "codex": {
          "$ref": "#/$defs/RuntimeUsage"
        }
      }
    }
  },
  "$defs": {
    "RuntimeUsage": {
      "type": "object",
      "required": [
        "auth",
        "status",
        "windows",
        "fetched_at"
      ],
      "properties": {
        "auth": {
          "description": "claude: subscription | api_key | none; codex: chatgpt | api_key | none.",
          "type": "string",
          "enum": [
            "subscription",
            "chatgpt",
            "api_key",
            "none"
          ]
        },
        "status": {
          "description": "unsupported when auth is api_key or none (no request is made).",
          "type": "string",
          "enum": [
            "ok",
            "error",
            "unsupported"
          ]
        },
        "plan": {
          "description": "Plan name as the runtime reports it, e.g. max, pro, plus.",
          "type": "string",
          "maxLength": 40
        },
        "windows": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/UsageWindow"
          }
        },
        "error": {
          "description": "Short failure reason (status error), never a credential.",
          "type": "string",
          "maxLength": 200
        },
        "fetched_at": {
          "description": "When the numbers were read; for a value taken from a rate-limit event, the event time.",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "UsageWindow": {
      "type": "object",
      "required": [
        "key",
        "used_percent"
      ],
      "properties": {
        "key": {
          "description": "claude: five_hour | weekly | weekly_opus | weekly_sonnet | weekly_model (a per-model weekly window, see label); codex: primary | secondary.",
          "type": "string",
          "maxLength": 40
        },
        "label": {
          "description": "Display name the server gives a scoped window (weekly_model), e.g. a model name.",
          "type": "string",
          "maxLength": 40
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "window_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "resets_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
