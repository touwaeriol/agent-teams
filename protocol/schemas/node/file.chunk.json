{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/file.chunk.json",
  "title": "FileChunk",
  "description": "One piece of a file upload (publish_file, write_shared_file). Chunks are sent before the tool.call that references their upload_id; the console keeps them until that call assembles them.",
  "x-direction": "node_to_console",
  "x-key": [
    "upload_id",
    "index"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "session_id",
    "upload_id",
    "index",
    "data"
  ],
  "properties": {
    "session_id": {
      "$ref": "common.json#/$defs/SessionId"
    },
    "open_gen": {
      "$ref": "common.json#/$defs/OpenGen"
    },
    "upload_id": {
      "$ref": "common.json#/$defs/UploadId"
    },
    "index": {
      "description": "0-based position of this chunk in the upload (all files concatenated in tool.call upload.files order).",
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "data": {
      "description": "Base64 of at most 1 MiB.",
      "type": "string",
      "maxLength": 1398104,
      "contentEncoding": "base64"
    }
  }
}
