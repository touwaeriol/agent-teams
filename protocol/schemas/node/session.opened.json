{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/session.opened.json",
  "title": "SessionOpened",
  "description": "Result of session.open.",
  "x-direction": "node_to_console",
  "x-key": [
    "session_id",
    "open_gen"
  ],
  "x-reliable": true,
  "type": "object",
  "required": [
    "session_id",
    "open_gen"
  ],
  "properties": {
    "session_id": {
      "$ref": "common.json#/$defs/SessionId"
    },
    "open_gen": {
      "$ref": "common.json#/$defs/OpenGen"
    },
    "sdk_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "init": {
      "$ref": "#/$defs/SessionInit"
    },
    "resume_failed": {
      "description": "resume could not find the transcript/thread; the console runs the hand-over flow.",
      "type": "boolean"
    },
    "error": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "resume_failed": {
        "const": true
      }
    },
    "required": [
      "resume_failed"
    ]
  },
  "then": {
    "required": [
      "error"
    ]
  },
  "else": {
    "required": [
      "init"
    ]
  },
  "$defs": {
    "SessionInit": {
      "title": "SessionInit",
      "description": "From initializationResult() (Codex: mcpServerStatus/list + sandbox config).",
      "type": "object",
      "required": [
        "tools"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permission_mode": {
          "type": "string"
        },
        "claude_code_version": {
          "type": "string"
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpServerStatus"
          }
        },
        "commands": {
          "description": "Slash commands the session offers besides Claude Code's own (role skills, plugin skills and commands), from initializationResult().commands without the builtin ones. Absent for Codex.",
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/SlashCommand"
          }
        },
        "effort": {
          "description": "The thinking effort the session runs with ('' or absent: the model's default).",
          "type": "string",
          "maxLength": 32
        },
        "models": {
          "description": "Models the session can switch to (Claude: initialize models; Codex: model/list; Antigravity: the session's availableModels). Absent when the runtime did not say.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ModelOption"
          }
        }
      }
    },
    "SlashCommand": {
      "title": "SlashCommand",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "argument_hint": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "McpServerStatus": {
      "title": "McpServerStatus",
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "ModelOption": {
      "title": "ModelOption",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "The value session.set_mode takes.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resolved": {
          "description": "Claude: the wire model id an alias resolves to.",
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "efforts": {
          "description": "Thinking effort levels the model takes; empty: none to choose.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 32
          }
        },
        "default_effort": {
          "type": "string",
          "maxLength": 32
        },
        "supports_auto": {
          "description": "Claude: the model supports the auto permission mode.",
          "type": "boolean"
        },
        "default": {
          "description": "The runtime's default model.",
          "type": "boolean"
        }
      }
    }
  }
}
