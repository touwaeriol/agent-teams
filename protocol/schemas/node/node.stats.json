{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/node/node.stats.json",
  "title": "NodeStats",
  "description": "Every 30 s, unreliable; drives the server-room rack lights.",
  "x-direction": "node_to_console",
  "x-reliable": false,
  "type": "object",
  "required": [
    "active_sessions",
    "parked_sessions",
    "queued",
    "mem_mb",
    "load1",
    "disk_free_mb"
  ],
  "properties": {
    "active_sessions": {
      "type": "integer",
      "minimum": 0
    },
    "parked_sessions": {
      "type": "integer",
      "minimum": 0
    },
    "queued": {
      "type": "integer",
      "minimum": 0
    },
    "mem_mb": {
      "type": "integer",
      "minimum": 0
    },
    "load1": {
      "type": "number",
      "minimum": 0
    },
    "disk_free_mb": {
      "type": "integer",
      "minimum": 0
    }
  }
}
