{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/tools/remember.json",
  "title": "RememberInput",
  "description": "Append a one-line note to the project memory index MEMORY.md (shortcut for small facts).",
  "x-tool": {
    "tiers": [
      "coordinator"
    ],
    "blocking": []
  },
  "type": "object",
  "required": [
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "common.json#/$defs/MemoryScope"
    }
  }
}
