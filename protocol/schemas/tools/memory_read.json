{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/tools/memory_read.json",
  "title": "MemoryReadInput",
  "description": "Read one project memory file in full (MEMORY.md or a topic file listed in it).",
  "x-tool": {
    "tiers": [
      "coordinator",
      "lead",
      "member"
    ],
    "blocking": []
  },
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "$ref": "common.json#/$defs/MemoryScope"
    }
  },
  "$defs": {
    "MemoryReadResult": {
      "title": "MemoryReadResult",
      "type": "object",
      "required": [
        "name",
        "description",
        "content",
        "updated_by",
        "updated_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "updated_by": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    }
  }
}
