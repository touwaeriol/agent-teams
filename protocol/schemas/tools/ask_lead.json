{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/tools/ask_lead.json",
  "title": "AskLeadInput",
  "description": "Ask the thread lead a question and wait for the answer.",
  "x-tool": {
    "tiers": [
      "member"
    ],
    "blocking": [
      "member"
    ]
  },
  "type": "object",
  "required": [
    "question"
  ],
  "additionalProperties": false,
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "AskLeadResult": {
      "title": "AskLeadResult",
      "$ref": "common.json#/$defs/QuestionAnswer"
    }
  }
}
