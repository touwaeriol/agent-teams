{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/tools/enqueue_merge.json",
  "title": "EnqueueMergeInput",
  "description": "Put a member branch into the merge queue, one entry per repository the task pushed (merged into the thread branch on GitHub, then CI). Give either member or task_id.",
  "x-tool": {
    "tiers": [
      "lead"
    ],
    "blocking": []
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "member": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "$ref": "common.json#/$defs/TaskId"
    },
    "repo": {
      "description": "Merge only this repository of the task (default: every repository the task pushed).",
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "base": {
      "description": "Base branch the thread uses in repo (only before the thread branch exists there; read the project context for stated bases).",
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    }
  },
  "oneOf": [
    {
      "required": [
        "member"
      ]
    },
    {
      "required": [
        "task_id"
      ]
    }
  ],
  "$defs": {
    "EnqueueMergeResult": {
      "title": "EnqueueMergeResult",
      "type": "object",
      "required": [
        "entry_id",
        "position"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "description": "One entry per repository.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MergeEntryRef"
          }
        }
      }
    },
    "MergeEntryRef": {
      "title": "MergeEntryRef",
      "type": "object",
      "required": [
        "entry_id",
        "repo"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        }
      }
    }
  }
}
