# Env file for deploy/compose.sh (default location: <repo>/.env, mode 0600).
COMPOSE_PROJECT_NAME=agent-teams
PORT=3001
BIND=127.0.0.1
AGENT_TEAMS_PUBLIC_URL=https://agent.example.com
# Generate once (openssl rand -hex 24) and never change them: the data directories are
# initialised with the passwords and AGENT_TEAMS_SECRET_KEY opens the sealed Git tokens.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
AGENT_TEAMS_SECRET_KEY=
AGENT_TEAMS_ADMIN_EMAILS=
# Object store (S3-compatible, e.g. RustFS) for attachments and shared files. Set all four of
# ENDPOINT, BUCKET, ACCESS_KEY, SECRET_KEY or none: with none, new uploads are refused (503) and
# files still in the database stay readable. After the first deploy with these set, move the old
# bytes: deploy/compose.sh run --rm control-plane storage migrate (then verify, purge-data).
AGENT_TEAMS_S3_ENDPOINT=
AGENT_TEAMS_S3_BUCKET=
AGENT_TEAMS_S3_ACCESS_KEY=
AGENT_TEAMS_S3_SECRET_KEY=
# Optional: what presigned URLs point at (default ENDPOINT), region (us-east-1), path-style (true).
# AGENT_TEAMS_S3_PUBLIC_ENDPOINT=
# AGENT_TEAMS_S3_REGION=us-east-1
# AGENT_TEAMS_S3_PATH_STYLE=true
# Optional: database role/name (default agent_teams).
# POSTGRES_USER=agent_teams
# POSTGRES_DB=agent_teams
# Optional: image tag, data and office directories (relative to the repository root).
# AGENT_TEAMS_IMAGE=agent-teams-server:latest
# DATA_DIR=./data
# OFFICE_HOST_DIR=./office
# BUILD_CONTEXT=.
