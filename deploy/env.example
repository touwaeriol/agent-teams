# 端口：留空时 deploy.sh 自动选 3001-3009 中第一个空闲端口
PORT=

# 用户和节点访问控制台的地址（节点安装命令、Claude Code leader 的 MCP 地址都用它）：
# 留空时 deploy.sh 按本机 IP 和端口生成；放在反向代理后面时填对外的地址
AGENT_TEAMS_PUBLIC_URL=

# 本机已有的 PostgreSQL（数据库需已存在；表名都带 at_ 前缀，可以放进现有库）
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/agent_teams

# 本机已有的 Valkey（有密码时写成 valkey://:PASSWORD@127.0.0.1:6379/0）
VALKEY_URL=valkey://127.0.0.1:6379/0

# 注册时自动成为管理员的邮箱（逗号分隔）；第一个注册的账号也会自动成为管理员
AGENT_TEAMS_ADMIN_EMAILS=
