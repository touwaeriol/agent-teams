# 端口：留空时 deploy.sh 自动选 3001-3009 中第一个空闲端口（服务只监听 127.0.0.1）
PORT=

# 用户和节点访问控制台的地址（节点安装命令、Claude Code leader 的 MCP 地址都用它）：
# 留空时 deploy.sh 按本机 IP 和端口生成；放在反向代理后面时填对外的 https 地址
AGENT_TEAMS_PUBLIC_URL=

# 以下三项留空时 deploy.sh 自动生成随机值（PostgreSQL 和 Valkey 都在同一个 compose 里）
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
# 加密保存 Git 访问令牌的密钥；生成后不要再改，否则已保存的令牌无法解密
AGENT_TEAMS_SECRET_KEY=

# 注册时自动成为管理员的邮箱（逗号分隔）；第一个注册的账号也会自动成为管理员
AGENT_TEAMS_ADMIN_EMAILS=
