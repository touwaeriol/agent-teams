# Copy to node.env (git-ignored) and fill in. Keep it private: it holds the node token.

# Control plane and this node's token (Nodes page → Add node).
AGENT_TEAMS_CONSOLE=https://agent.prophey.ai
AGENT_TEAMS_NODE_TOKEN=

# Optional: cap on concurrent employee sessions (empty = no limit), log level.
# AGENT_TEAMS_MAX_SESSIONS=
AGENT_TEAMS_LOG_LEVEL=info

# Claude auth, option 1: one of these (option 2: leave both commented out and run `claude login` in the container).
# CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token` (subscription); ANTHROPIC_API_KEY from the Console.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Codex auth (optional): an API key, or run `codex login` in the container.
# OPENAI_API_KEY=
