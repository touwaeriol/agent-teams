# deploy/v2 env file (production: <repo>/.env, already present from v1 — keep its values).
COMPOSE_PROJECT_NAME=agent-teams
PORT=3001
BIND=127.0.0.1
AGENT_TEAMS_PUBLIC_URL=https://agent.example.com
# Reuse the v1 values unchanged; AGENT_TEAMS_SECRET_KEY opens the sealed Git tokens.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
AGENT_TEAMS_SECRET_KEY=
AGENT_TEAMS_ADMIN_EMAILS=
# Optional: database role/name if the v1 compose used others (default agent_teams).
# POSTGRES_USER=agent_teams
# POSTGRES_DB=agent_teams
# Optional: image tag, data and office directories (relative to the repository root).
# AGENT_TEAMS_IMAGE=agent-teams-server:latest
# DATA_DIR=./data
# OFFICE_HOST_DIR=./office
# BUILD_CONTEXT=.
